{
  "name": "@starter/db",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./formula-codec": "./src/formula-codec.ts",
    "./seed-agency-templates": "./src/seed-agency-templates.ts",
    "./permissions-registry": "./src/permissions-registry.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate --config=drizzle.config.ts",
    "push": "drizzle-kit push --config=drizzle.config.ts",
    "migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "studio": "drizzle-kit studio --config=drizzle.config.ts --port=5558",
    "seed": "tsx src/seed.ts",
    "rebuild": "tsx src/wipe-and-rebuild.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.0.0",
    "@types/uuid": "^11.0.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5"
  }
}
